<Window x:Class="WpfContacts.ContactDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        AutomationProperties.AutomationId="ContactDialog"
        Title="联系人"
        Height="320" Width="380"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Owner="">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 姓名 -->
        <Label Grid.Row="0" Content="姓名：" Target="{Binding ElementName=TxtName}" />
        <TextBox Grid.Row="1" x:Name="TxtName"
                 AutomationProperties.AutomationId="TxtName"
                 Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                 Margin="0,0,0,8" Padding="6,4" />

        <!-- 电话 -->
        <Label Grid.Row="2" Content="电话：" Target="{Binding ElementName=TxtPhone}" />
        <TextBox Grid.Row="3" x:Name="TxtPhone"
                 AutomationProperties.AutomationId="TxtPhone"
                 Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}"
                 Margin="0,0,0,8" Padding="6,4" />

        <!-- 邮箱 -->
        <Label Grid.Row="4" Content="邮箱：" Target="{Binding ElementName=TxtEmail}" />
        <TextBox Grid.Row="5" x:Name="TxtEmail"
                 AutomationProperties.AutomationId="TxtEmail"
                 Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                 Margin="0,0,0,8" Padding="6,4" />

        <!-- 分组 -->
        <Label Grid.Row="6" Content="分组：" Target="{Binding ElementName=ComboGroup}" />
        <ComboBox Grid.Row="7" x:Name="ComboGroup"
                  AutomationProperties.AutomationId="ComboGroup"
                  SelectedValue="{Binding Group}"
                  Margin="0,0,0,14" Padding="6,4">
            <ComboBoxItem Content="朋友" IsSelected="True" />
            <ComboBoxItem Content="家人" />
            <ComboBoxItem Content="同事" />
            <ComboBoxItem Content="其他" />
        </ComboBox>

        <!-- 按钮 -->
        <StackPanel Grid.Row="8" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button AutomationProperties.AutomationId="BtnSave"
                    Content="保存" Width="80" Height="30" Margin="0,0,8,0"
                    IsDefault="True"
                    Click="OnSaveClick" />
            <Button AutomationProperties.AutomationId="BtnCancel"
                    Content="取消" Width="80" Height="30"
                    IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
