<Window x:Class="WpfContacts.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfContacts"
        mc:Ignorable="d"
        AutomationProperties.AutomationId="MainWindow"
        Title="通讯录"
        Height="550" Width="500"
        MinWidth="400" MinHeight="400"
        WindowStartupLocation="CenterScreen">

    <Window.DataContext>
        <local:MainViewModel />
    </Window.DataContext>

    <DockPanel Margin="10">
        <!-- 顶部工具栏 -->
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <!-- 搜索框 -->
            <TextBox AutomationProperties.AutomationId="TxtSearch"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="搜索联系人..."
                     Margin="0,0,0,8" Padding="8,6" />

            <!-- 操作按钮 -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <Button AutomationProperties.AutomationId="BtnAdd"
                        Content="添加" Width="80" Margin="0,0,6,0"
                        Command="{Binding AddContactCommand}" />
                <Button AutomationProperties.AutomationId="BtnEdit"
                        Content="编辑" Width="80" Margin="0,0,6,0"
                        Command="{Binding EditContactCommand}" />
                <Button AutomationProperties.AutomationId="BtnDelete"
                        Content="删除" Width="80"
                        Command="{Binding DeleteContactCommand}" />
            </StackPanel>
        </StackPanel>

        <!-- 联系人列表 -->
        <ListView AutomationProperties.AutomationId="ListContacts"
                  ItemsSource="{Binding Contacts}"
                  SelectedItem="{Binding SelectedContact}"
                  DockPanel.Dock="Top"
                  Margin="0,0,0,6">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="姓名" Width="120"
                                    DisplayMemberBinding="{Binding Name}" />
                    <GridViewColumn Header="电话" Width="130"
                                    DisplayMemberBinding="{Binding Phone}" />
                    <GridViewColumn Header="邮箱" Width="180"
                                    DisplayMemberBinding="{Binding Email}" />
                    <GridViewColumn Header="分组" Width="80"
                                    DisplayMemberBinding="{Binding Group}" />
                </GridView>
            </ListView.View>
        </ListView>

        <!-- 状态栏 -->
        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock AutomationProperties.AutomationId="TxtStatus"
                           Text="{Binding StatusText}" />
            </StatusBarItem>
        </StatusBar>

        <!-- 消息区域（临时提示） -->
        <TextBlock x:Name="TxtMessage"
                   AutomationProperties.AutomationId="TxtMessage"
                   DockPanel.Dock="Bottom"
                   TextAlignment="Center"
                   Foreground="#4A90D9"
                   FontSize="12"
                   Margin="0,4,0,0" />
    </DockPanel>
</Window>
