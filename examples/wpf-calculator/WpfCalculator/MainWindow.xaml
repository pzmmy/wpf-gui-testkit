<Window x:Class="WpfCalculator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="计算器" Height="400" Width="300"
        MinWidth="260" MinHeight="360"
        ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterScreen"
        AutomationProperties.AutomationId="MainWindow">

    <Window.Resources>
        <Style x:Key="BtnStyle" TargetType="Button">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="MinHeight" Value="40"/>
        </Style>
        <Style x:Key="OpBtnStyle" TargetType="Button" BasedOn="{StaticResource BtnStyle}">
            <Setter Property="Background" Value="#FFF0E0"/>
        </Style>
        <Style x:Key="NumBtnStyle" TargetType="Button" BasedOn="{StaticResource BtnStyle}">
            <Setter Property="Background" Value="#F5F5F5"/>
        </Style>
    </Window.Resources>

    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 表达式显示 -->
        <TextBlock x:Name="ExpressionText"
                   Grid.Row="0"
                   TextAlignment="Right"
                   FontSize="14"
                   Foreground="#888"
                   Margin="4,4,4,0"
                   Height="20"/>

        <!-- 结果显示 -->
        <Border Grid.Row="1"
                Background="#FAFAFA"
                CornerRadius="6"
                Margin="0,2,0,6"
                Padding="8,4">
            <TextBlock x:Name="DisplayText"
                       Text="0"
                       TextAlignment="Right"
                       FontSize="32"
                       FontWeight="SemiBold"
                       AutomationProperties.AutomationId="DisplayText"/>
        </Border>

        <!-- 按钮区域 -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 第一行 -->
            <Button Grid.Row="0" Grid.Column="0" Content="C"
                    Style="{StaticResource OpBtnStyle}"
                    Click="Clear_Click"
                    AutomationProperties.AutomationId="BtnClear"/>
            <Button Grid.Row="0" Grid.Column="1" Content="±"
                    Style="{StaticResource OpBtnStyle}"
                    Click="Negate_Click"
                    AutomationProperties.AutomationId="BtnNegate"/>
            <Button Grid.Row="0" Grid.Column="2" Content="←"
                    Style="{StaticResource OpBtnStyle}"
                    Click="Backspace_Click"
                    AutomationProperties.AutomationId="BtnBackspace"/>
            <Button Grid.Row="0" Grid.Column="3" Content="÷"
                    Style="{StaticResource OpBtnStyle}"
                    Click="Operator_Click"
                    AutomationProperties.AutomationId="BtnDivide"/>

            <!-- 第二行 -->
            <Button Grid.Row="1" Grid.Column="0" Content="7"
                    Style="{StaticResource NumBtnStyle}"
                    Click="Number_Click"
                    AutomationProperties.AutomationId="Btn7"/>
            <Button Grid.Row="1" Grid.Column="1" Content="8"
                    Style="{StaticResource NumBtnStyle}"
                    Click="Number_Click"
                    AutomationProperties.AutomationId="Btn8"/>
            <Button Grid.Row="1" Grid.Column="2" Content="9"
                    Style="{StaticResource NumBtnStyle}"
                    Click="Number_Click"
                    AutomationProperties.AutomationId="Btn9"/>
            <Button Grid.Row="1" Grid.Column="3" Content="×"
                    Style="{StaticResource OpBtnStyle}"
                    Click="Operator_Click"
                    AutomationProperties.AutomationId="BtnMultiply"/>

            <!-- 第三行 -->
            <Button Grid.Row="2" Grid.Column="0" Content="4"
                    Style="{StaticResource NumBtnStyle}"
                    Click="Number_Click"
                    AutomationProperties.AutomationId="Btn4"/>
            <Button Grid.Row="2" Grid.Column="1" Content="5"
                    Style="{StaticResource NumBtnStyle}"
                    Click="Number_Click"
                    AutomationProperties.AutomationId="Btn5"/>
            <Button Grid.Row="2" Grid.Column="2" Content="6"
                    Style="{StaticResource NumBtnStyle}"
                    Click="Number_Click"
                    AutomationProperties.AutomationId="Btn6"/>
            <Button Grid.Row="2" Grid.Column="3" Content="-"
                    Style="{StaticResource OpBtnStyle}"
                    Click="Operator_Click"
                    AutomationProperties.AutomationId="BtnMinus"/>

            <!-- 第四行 -->
            <Button Grid.Row="3" Grid.Column="0" Content="1"
                    Style="{StaticResource NumBtnStyle}"
                    Click="Number_Click"
                    AutomationProperties.AutomationId="Btn1"/>
            <Button Grid.Row="3" Grid.Column="1" Content="2"
                    Style="{StaticResource NumBtnStyle}"
                    Click="Number_Click"
                    AutomationProperties.AutomationId="Btn2"/>
            <Button Grid.Row="3" Grid.Column="2" Content="3"
                    Style="{StaticResource NumBtnStyle}"
                    Click="Number_Click"
                    AutomationProperties.AutomationId="Btn3"/>
            <Button Grid.Row="3" Grid.Column="3" Content="+"
                    Style="{StaticResource OpBtnStyle}"
                    Click="Operator_Click"
                    AutomationProperties.AutomationId="BtnPlus"/>

            <!-- 第五行 -->
            <Button Grid.Row="4" Grid.Column="0" Content="0"
                    Style="{StaticResource NumBtnStyle}"
                    Click="Number_Click"
                    AutomationProperties.AutomationId="Btn0"/>
            <Button Grid.Row="4" Grid.Column="1" Content="."
                    Style="{StaticResource NumBtnStyle}"
                    Click="Decimal_Click"
                    AutomationProperties.AutomationId="BtnDecimal"/>
            <Button Grid.Row="4" Grid.Column="2" Content="00"
                    Style="{StaticResource NumBtnStyle}"
                    Click="Number_Click"
                    AutomationProperties.AutomationId="BtnDoubleZero"/>
            <Button Grid.Row="4" Grid.Column="3" Content="="
                    Style="{StaticResource OpBtnStyle}"
                    Background="#FFD4A574"
                    Foreground="White"
                    FontWeight="Bold"
                    Click="Equals_Click"
                    AutomationProperties.AutomationId="BtnEquals"/>
        </Grid>
    </Grid>
</Window>
