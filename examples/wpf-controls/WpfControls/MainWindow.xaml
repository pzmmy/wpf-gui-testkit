<Window x:Class="WpfControls.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WPF Controls Demo"
        Height="480" Width="460"
        MinWidth="400" MinHeight="400"
        ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterScreen"
        AutomationProperties.AutomationId="MainWindow">

    <Window.Resources>
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,8,0,2"/>
        </Style>
        <Style x:Key="ValueLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#555"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="10">
        <StackPanel>

            <!-- ═══ ToggleButton ═══ -->
            <TextBlock Text="ToggleButton" Style="{StaticResource SectionHeader}"
                       AutomationProperties.AutomationId="LblToggleHeader"/>
            <WrapPanel>
                <ToggleButton Content="Wi-Fi"
                              AutomationProperties.AutomationId="ToggleWiFi"
                              Margin="2" Width="100" Height="32"
                              IsChecked="True"
                              Checked="Toggle_Checked"
                              Unchecked="Toggle_Unchecked"/>
                <ToggleButton Content="Bluetooth"
                              AutomationProperties.AutomationId="ToggleBluetooth"
                              Margin="2" Width="100" Height="32"/>
                <ToggleButton Content="Airplane"
                              AutomationProperties.AutomationId="ToggleAirplane"
                              Margin="2" Width="100" Height="32"/>
                <TextBlock x:Name="TxtToggleStatus"
                           Style="{StaticResource ValueLabel}"
                           AutomationProperties.AutomationId="TxtToggleStatus"
                           Text="Wi-Fi: ON"/>
            </WrapPanel>

            <!-- ═══ RadioButton ═══ -->
            <TextBlock Text="RadioButton (Theme)" Style="{StaticResource SectionHeader}"
                       AutomationProperties.AutomationId="LblRadioHeader"/>
            <WrapPanel>
                <RadioButton GroupName="Theme" Content="Light"
                             AutomationProperties.AutomationId="RadioLight"
                             Margin="4,0,16,0" IsChecked="True"
                             Checked="Radio_Checked"/>
                <RadioButton GroupName="Theme" Content="Dark"
                             AutomationProperties.AutomationId="RadioDark"
                             Margin="4,0,16,0"/>
                <RadioButton GroupName="Theme" Content="System"
                             AutomationProperties.AutomationId="RadioSystem"
                             Margin="4,0,16,0"/>
            </WrapPanel>
            <TextBlock x:Name="TxtRadioStatus"
                       AutomationProperties.AutomationId="TxtRadioStatus"
                       Text="Theme: Light" Foreground="#555" Margin="0,0,0,2"/>

            <!-- ═══ Slider ═══ -->
            <TextBlock Text="Slider (Volume)" Style="{StaticResource SectionHeader}"
                       AutomationProperties.AutomationId="LblSliderHeader"/>
            <StackPanel Orientation="Horizontal">
                <Slider x:Name="SliderVolume"
                        AutomationProperties.AutomationId="SliderVolume"
                        Minimum="0" Maximum="100" Value="50"
                        Width="200" Margin="4"
                        ValueChanged="Slider_ValueChanged"/>
                <TextBlock x:Name="TxtSliderValue"
                           AutomationProperties.AutomationId="TxtSliderValue"
                           Text="50" Style="{StaticResource ValueLabel}"/>
            </StackPanel>

            <!-- ═══ Expander ═══ -->
            <TextBlock Text="Expander" Style="{StaticResource SectionHeader}"
                       AutomationProperties.AutomationId="LblExpanderHeader"/>
            <Expander Header="Advanced Settings"
                      AutomationProperties.AutomationId="ExpanderAdvanced"
                      IsExpanded="False"
                      Expanded="Expander_StateChanged"
                      Collapsed="Expander_StateChanged">
                <StackPanel Margin="12">
                    <TextBlock Text="Auto-update" Margin="0,0,0,8"/>
                    <CheckBox Content="Enable auto-update"
                              AutomationProperties.AutomationId="ChkAutoUpdate"
                              IsChecked="True"/>
                    <CheckBox Content="Send usage data"
                              AutomationProperties.AutomationId="ChkUsageData"
                              Margin="0,6,0,0"/>
                    <TextBlock x:Name="TxtExpanderStatus"
                               AutomationProperties.AutomationId="TxtExpanderStatus"
                               Text="Expander: Collapsed"
                               Foreground="#555" Margin="0,8,0,0"/>
                </StackPanel>
            </Expander>

            <!-- ═══ DatePicker ═══ -->
            <TextBlock Text="DatePicker" Style="{StaticResource SectionHeader}"
                       AutomationProperties.AutomationId="LblDateHeader"/>
            <WrapPanel Margin="0,0,0,4">
                <DatePicker x:Name="DatePickerStart"
                            AutomationProperties.AutomationId="DatePickerStart"
                            Margin="4" Width="140"
                            SelectedDateChanged="DatePicker_Changed"/>
                <TextBlock x:Name="TxtDateStatus"
                           AutomationProperties.AutomationId="TxtDateStatus"
                           Text="No date selected"
                           Style="{StaticResource ValueLabel}"/>
            </WrapPanel>

            <!-- ═══ ProgressBar ═══ -->
            <TextBlock Text="ProgressBar" Style="{StaticResource SectionHeader}"
                       AutomationProperties.AutomationId="LblProgressHeader"/>
            <WrapPanel>
                <ProgressBar x:Name="ProgressBarDemo"
                             AutomationProperties.AutomationId="ProgressBarDemo"
                             Minimum="0" Maximum="100" Value="67"
                             Width="200" Height="24" Margin="4"/>
                <Button Content="Start"
                        AutomationProperties.AutomationId="BtnProgressStart"
                        Click="Progress_Start_Click"
                        Margin="4" Width="70" Height="28"/>
                <Button Content="Reset"
                        AutomationProperties.AutomationId="BtnProgressReset"
                        Click="Progress_Reset_Click"
                        Margin="4" Width="70" Height="28"/>
                <TextBlock x:Name="TxtProgressStatus"
                           AutomationProperties.AutomationId="TxtProgressStatus"
                           Text="67%"
                           Style="{StaticResource ValueLabel}"/>
            </WrapPanel>

            <!-- ═══ ToolBar + Separator ═══ -->
            <TextBlock Text="ToolBar" Style="{StaticResource SectionHeader}"
                       AutomationProperties.AutomationId="LblToolbarHeader"/>
            <ToolBar AutomationProperties.AutomationId="ToolBarMain"
                     Margin="0,0,0,4">
                <Button AutomationProperties.AutomationId="BtnToolNew"
                        Content="New"/>
                <Separator AutomationProperties.AutomationId="SepTool1"/>
                <Button AutomationProperties.AutomationId="BtnToolSave"
                        Content="Save"/>
                <Button AutomationProperties.AutomationId="BtnToolDelete"
                        Content="Delete"/>
            </ToolBar>

            <!-- ═══ GroupBox ═══ -->
            <TextBlock Text="GroupBox" Style="{StaticResource SectionHeader}"
                       AutomationProperties.AutomationId="LblGroupBoxHeader"/>
            <GroupBox Header="Preferences"
                      AutomationProperties.AutomationId="GroupBoxPrefs"
                      Margin="0,0,0,4" Padding="8">
                <StackPanel>
                    <CheckBox Content="Notify on updates"
                              AutomationProperties.AutomationId="ChkNotify"
                              Margin="0,0,0,4"/>
                    <ComboBox AutomationProperties.AutomationId="ComboLanguage"
                              Width="140">
                        <ComboBoxItem Content="English" IsSelected="True"/>
                        <ComboBoxItem Content="中文"/>
                        <ComboBoxItem Content="日本語"/>
                    </ComboBox>
                    <TextBlock x:Name="TxtGroupBoxStatus"
                               AutomationProperties.AutomationId="TxtGroupBoxStatus"
                               Text="GroupBox ready" Foreground="#555"/>
                </StackPanel>
            </GroupBox>

        </StackPanel>
    </ScrollViewer>
</Window>
